# Copy this file to .env.local and fill in the values
# .env.local is gitignored — never commit real values

# Backend API URL
# Local dev:
VITE_API_URL=http://localhost:8000
# Production (uncomment when deploying):
# VITE_API_URL=https://voyageur-1i0h.onrender.com

# Google OAuth Client ID (safe to share — it's a public identifier)
# Get it from: console.cloud.google.com → APIs & Services → Credentials
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
